# Copiar este archivo como ".env" (sin .example) y llenar los valores reales.
# NUNCA subir el .env a GitHub ni compartirlo.

# Base de datos MySQL (usa el usuario enfermeria_app, no root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enfermeria_escolar
DB_USER=enfermeria_app
DB_PASSWORD=

# Firma de las cookies de sesión. Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# IA (opcional)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
